# ---------------------------------------------------------------------------
# BBB Render Studio -- provider credentials
# Copy to .env and fill in only the providers you actually intend to use.
# With no keys set the server runs in MOCK mode: the whole UI works, jobs
# complete on a timer, and no money is spent. Good for demos and UI work.
# ---------------------------------------------------------------------------

# Leave as 1 to run without any provider account.
MOCK_MODE=1

PORT=5178

# fal.ai -- primary provider. Inference + Flux LoRA training.
# https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate -- fallback / cheaper batch inference, also trains Flux LoRAs.
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Google Gemini -- "Nano Banana" / Nano Banana Pro image models.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face -- model metadata, dataset hosting, private LoRA storage.
# Inference via HF routes to third-party providers and is billed.
# https://huggingface.co/settings/tokens
HF_TOKEN=
