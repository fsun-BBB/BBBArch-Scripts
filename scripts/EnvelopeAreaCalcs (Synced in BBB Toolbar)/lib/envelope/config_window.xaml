<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Energy Code Elevations - Configuration"
        SizeToContent="Height" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F3F3F3" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,5,0,5"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#666"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Window.Resources>

  <StackPanel>

    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
            Padding="20,16" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal">
        <Image x:Name="header_icon" Width="32" Height="32" Margin="0,0,12,0"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Energy Code Elevations" FontSize="18" FontWeight="SemiBold"
                     Foreground="#201F1E"/>
          <TextBlock Text="What counts as envelope, how repeated elements group, and what to clean up."
                     FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Margin="20,0,20,20">

    <Border Style="{DynamicResource CardFluent}" Padding="16,14"
            Effect="{DynamicResource ElevationLow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Revit Categories to Include"
                     FontWeight="SemiBold" FontSize="14" Foreground="#323130"/>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Which element categories the tool scans and draws a region for."/>
        </StackPanel>
        <Button x:Name="btn_pick_categories" Content="Select Types"
                Style="{DynamicResource ButtonFluentSecondary}"
                Grid.Column="1" VerticalAlignment="Center" Click="pick_categories"/>
      </Grid>
    </Border>

    <Border Style="{DynamicResource CardFluent}" Padding="16,14" Margin="0,0,0,24"
            Effect="{DynamicResource ElevationLow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Limit to specific types"
                     FontWeight="SemiBold" FontSize="14" Foreground="#323130"/>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Narrow an included category down to specific types only, instead of every type in it."/>
        </StackPanel>
        <Button x:Name="btn_pick_types" Content="Choose types..."
                Style="{DynamicResource ButtonFluentSecondary}"
                Grid.Column="1" VerticalAlignment="Center" Click="pick_types"/>
      </Grid>
    </Border>

    <Border Style="{DynamicResource CardFluent}" Padding="16,14"
            Effect="{DynamicResource ElevationLow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Grouping" FontWeight="SemiBold" FontSize="14"
                     Foreground="#323130"/>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Combine similar wall types into one reporting row and colour, instead of one row per type."/>
        </StackPanel>
        <Button x:Name="btn_groups" Content="Merge wall types..."
                Style="{DynamicResource ButtonFluentSecondary}"
                Grid.Column="1" VerticalAlignment="Center" Click="edit_groups"/>
      </Grid>
    </Border>

    <Border Style="{DynamicResource CardFluent}" Padding="16,14"
            Effect="{DynamicResource ElevationLow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Create Detail Groups"
                     FontWeight="SemiBold" FontSize="14" Foreground="#323130"/>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Draw matching windows/doors/panels once and group the rest, so editing one instance edits every match."/>
        </StackPanel>
        <Button x:Name="btn_detail_group" Content="Configure"
                Style="{DynamicResource ButtonFluentSecondary}"
                Grid.Column="1" VerticalAlignment="Center" Click="edit_detail_groups"/>
      </Grid>
    </Border>

    <Border Style="{DynamicResource CardFluent}" Margin="0,0,0,0" Padding="16,14"
            Effect="{DynamicResource ElevationLow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Purge" FontWeight="SemiBold" FontSize="14"
                     Foreground="#323130"/>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Remove filled regions, the schedule, region types, or parameters this tool created."/>
        </StackPanel>
        <Button x:Name="btn_purge" Content="Purge..."
                Style="{DynamicResource ButtonFluentSecondary}"
                Grid.Column="1" VerticalAlignment="Center" Click="purge"/>
      </Grid>
    </Border>

    </StackPanel>

    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
            Padding="20,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btn_cancel" Content="Cancel" Padding="16,6"
                Style="{DynamicResource ButtonFluentGhost}" Foreground="#666"
                Click="cancel"/>
        <Button x:Name="btn_ok" Content="Save" Padding="20,6" Margin="8,0,0,0"
                Style="{DynamicResource ButtonFluentPrimary}"
                IsDefault="True" Click="confirm"/>
      </StackPanel>
    </Border>

  </StackPanel>
</Window>
